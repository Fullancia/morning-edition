# Required: the password for the dashboard.
DASHBOARD_PASSWORD=change-me
# Required for Claude to pick and write stories. Without it the paper prints feed teasers.
ANTHROPIC_API_KEY=
# Optional: a long random string; defaults to one derived from the password.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Optional: host port for the dashboard.
PORT=8080
# Optional: container timezone for logs. The paper's own timezone is set in the dashboard.
TZ=UTC
# Required for one-click updates: a long random string shared by the app and its updater container.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
WATCHTOWER_TOKEN=
